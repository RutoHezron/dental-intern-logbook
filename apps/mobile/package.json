{
  "name": "@logbook/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Android app (Capacitor) wrapping the @logbook/web build",
  "scripts": {
    "sync": "npm run build -w @logbook/web && cap sync android",
    "open": "cap open android",
    "apk": "npm run sync && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@logbook/web": "^0.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "^5.9.3"
  }
}
