# Sync server (Supabase). Leave empty to run local-only.
# Local stack: run `npx supabase start` and copy the API URL and anon key it prints.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Daily push reminders (optional). Generate a key pair with `npx web-push generate-vapid-keys`;
# the public key goes here, the private key only into the send-reminders function secrets.
VITE_VAPID_PUBLIC_KEY=
