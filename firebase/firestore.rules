rules_version = '2';
// The app never reads or writes Firestore directly: every request goes
// through the Cloud Functions in functions/src, which check who is calling
// and enforce the logbook's rules (the same model as the Postgres RPCs).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
