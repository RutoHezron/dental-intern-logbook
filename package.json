{
  "name": "dental-intern-logbook",
  "private": true,
  "version": "0.1.0",
  "description": "Digital Dental Internship Logbook, Clinical Diary & Progressive Reporting Platform",
  "workspaces": [
    "packages/*",
    "apps/*",
    "firebase/functions"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @logbook/web",
    "dev": "npm run dev -w @logbook/web",
    "android:sync": "npm run sync -w @logbook/mobile",
    "android:apk": "npm run apk -w @logbook/mobile",
    "android:open": "npm run open -w @logbook/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}
